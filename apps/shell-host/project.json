{
  "name": "@recrm/shell-host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shell-host/src",
  "// targets": "to see all targets run: nx show project shell-host --web",
  "targets": {
    "dev": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "@recrm/shell-host:build"
      }
    },

    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/apps/shell-host",
        "configFile": "apps/shell-host/vite.config.mts"
      }
    }
  }
}
